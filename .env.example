# İlk açılışta bu bilgilerle yönetici hesabı oluşturulur (hesap varsa dokunulmaz).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=degistir-en-az-12-karakter

# SQLite dosya yolu. Sunucuda kalıcı bir klasör gösterin.
DATABASE_PATH=./.data/coreandfit.sqlite

# 1 verilirse demo üyeler, randevular ve ölçümler eklenir. Canlıda 0 bırakın.
SEED_DEMO=0
DEMO_MEMBER_PASSWORD=

# Production'da oturum çerezi Secure gönderilir. Yalnızca HTTPS olmayan bir test sunucusunda 0 yapın.
COOKIE_SECURE=1

# PayTR (Mağaza Paneli › Bilgi sayfası). Anahtarlar yalnızca burada durur, admin panelinden girilmez.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu (gerçek çekim yok). Canlıya geçerken 0 yapın.
PAYTR_TEST_MODE=1
# 1 = yalnızca tek çekim. Taksit için 0 ve PAYTR_MAX_INSTALLMENT (0-12).
PAYTR_NO_INSTALLMENT=1
PAYTR_MAX_INSTALLMENT=0
# Sitenin herkese açık adresi (PayTR dönüş sayfaları için), sonunda / olmadan
APP_BASE_URL=https://www.coreandfit.com.tr
